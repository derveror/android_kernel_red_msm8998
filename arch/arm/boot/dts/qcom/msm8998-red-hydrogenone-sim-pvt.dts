/dts-v1/;

#include "msm8998-v2.1.dtsi"
#include "msm8998-mdss-panels.dtsi"
#include "msm8998-mtp.dtsi"
#include "msm8998-red-hydrogenone-common.dtsi"
#include "msm8998-red-hydrogenone-pvt.dtsi"
