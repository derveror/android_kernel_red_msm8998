/ {
	model = "Qualcomm Technologies, Inc. MSM8998 v2.1 MTP, CloudMinds redphone SIM PVT";
	compatible = "qcom,msm8998-mtp", "qcom,msm8998", "qcom,mtp";
	qcom,board-id = <8 0 1 0>;
	fih,hw-id = <4 4 0>;
	cm,display-id = <0x7f>;
};
