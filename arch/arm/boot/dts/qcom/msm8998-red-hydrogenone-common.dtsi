		qcom,cam-vreg-name = "cam_vio", "cam_vana", "cam_vdig",
			"cam_v_custom1";
		qcom,cam-vreg-min-voltage = <0 3312000 1352000 1800000>;
		qcom,cam-vreg-max-voltage = <0 3600000 1352000 1800000>;
		qcom,cam-vreg-op-mode = <0 80000 105000 80000>;
		qcom,gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk0_active
			&red_cam_sensor_front_wide_active>;
		pinctrl-1 = <&cam_sensor_mclk0_suspend
			&red_cam_sensor_front_wide_suspend>;
		gpios = <&tlmm 13 0>, <&tlmm 30 0>, <&tlmm 29 0>,
			<&tlmm 33 0>, <&tlmm 34 0>;
		qcom,gpio-reset = <1>;
		qcom,gpio-vana = <2>;
		qcom,gpio-custom1 = <3>;
		qcom,gpio-custom2 = <4>;
		qcom,gpio-req-tbl-num = <0 1 2 3 4>;
		qcom,gpio-req-tbl-flags = <1 0 0 0 0>;
		qcom,gpio-req-tbl-label = "CAMIF_MCLK0", "CAM_RESET2",
			"CAM_VANA1", "CAM_CUSTOM1", "CAM_CUSTOM2";
		qcom,sensor-position = <1>;
		qcom,sensor-mode = <0>;
		qcom,cci-master = <0>;
		status = "ok";
		clocks = <&clock_mmss clk_mclk0_clk_src>,
			<&clock_mmss clk_mmss_camss_mclk0_clk>;
		clock-names = "cam_src_clk", "cam_clk";
		qcom,clock-rates = <24000000 0>;
	};

	red_eeprom3: qcom,eeprom@3 {
		cell-index = <3>;
		reg = <3>;
		compatible = "qcom,eeprom";
		cam_vio-supply = <&pm8998_lvs1>;
		cam_vana-supply = <&pmi8998_bob>;
		cam_vdig-supply = <&pm8998_s3>;
		cam_v_custom1-supply = <&pm8998_s4>;
		qcom,cam-vreg-name = "cam_vio", "cam_vana", "cam_vdig",
			"cam_v_custom1";
		qcom,cam-vreg-min-voltage = <0 3312000 1352000 1800000>;
		qcom,cam-vreg-max-voltage = <0 3600000 1352000 1800000>;
		qcom,cam-vreg-op-mode = <0 80000 105000 80000>;
		qcom,gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk0_active
			&red_cam_sensor_front_wide_active>;
		pinctrl-1 = <&cam_sensor_mclk0_suspend
			&red_cam_sensor_front_wide_suspend>;
		gpios = <&tlmm 13 0>, <&tlmm 30 0>, <&tlmm 29 0>,
			<&tlmm 33 0>, <&tlmm 34 0>;
		qcom,gpio-reset = <1>;
		qcom,gpio-vana = <2>;
		qcom,gpio-custom1 = <3>;
		qcom,gpio-custom2 = <4>;
		qcom,gpio-req-tbl-num = <0 1 2 3 4>;
		qcom,gpio-req-tbl-flags = <1 0 0 0 0>;
		qcom,gpio-req-tbl-label = "CAMIF_MCLK0", "CAM_RESET2",
			"CAM_VANA1", "CAM_CUSTOM1", "CAM_CUSTOM2";
		qcom,sensor-position = <1>;
		qcom,sensor-mode = <0>;
		qcom,cci-master = <0>;
		status = "ok";
		clocks = <&clock_mmss clk_mclk0_clk_src>,
			<&clock_mmss clk_mmss_camss_mclk0_clk>;
		clock-names = "cam_src_clk", "cam_clk";
		qcom,clock-rates = <24000000 0>;
	};
};

&soc {
	fpc1020 {
		compatible = "fpc,fpc1020";
		status = "ok";

		interrupt-parent = <&tlmm>;
		interrupts = <121 0>;
		fpc,gpio_irq = <&tlmm 121 0>;
		fpc,gpio_rst = <&tlmm 32 0>;

		pinctrl-names = "fpc1020_reset_reset",
			"fpc1020_reset_active", "fpc1020_irq_active";
		pinctrl-0 = <&fpc_reset_low>;
		pinctrl-1 = <&fpc_reset_high>;
		pinctrl-2 = <&fpc_irq_active>;

		vcc_spi-supply = <&pm8998_s4>;
		vdd_ana-supply = <&pm8998_l18>;
		vdd_io-supply = <&pm8998_l18>;
		fpc,enable-on-boot;
	};
};

&i2c_8 {
	status = "okay";

	tfa98xx_left@34 {
		compatible = "nxp,tfa98xx";
		reg = <0x34>;
		reset-gpio = <&tlmm 86 1>;
		irq-gpio = <&tlmm 21 1>;
		tfa98xx,fw-name = "tfa98xx_a3d.cnt";
	};

	tfa98xx_right@35 {
		compatible = "nxp,tfa98xx";
		reg = <0x35>;
		irq-gpio = <&tlmm 62 1>;
	};
};

&i2c_5 {
	status = "okay";
	/delete-node/ synaptics@20;

	red_synaptics: synaptics_dsx@70 {
		compatible = "synaptics,dsx-i2c";
		reg = <0x70>;
		interrupt-parent = <&tlmm>;
		interrupts = <125 0x2008>;
		vdd-supply = <&pm8998_l6>;

		pinctrl-names = "pmx_ts_active", "pmx_ts_suspend";
		pinctrl-0 = <&ts_active>;
		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;

		synaptics,bus-reg-name = "vdd";
		synaptics,display-coords = <0 0 1439 2559>;
		synaptics,panel-coords = <0 0 1439 2559>;
		synaptics,reset-gpio = <&tlmm 89 0>;
		synaptics,irq-gpio = <&tlmm 125 0x2008>;
		synaptics,reset-on-state = <0>;
		synaptics,irq-on-state = <0>;
		synaptics,power-delay-ms = <200>;
		synaptics,reset-active-ms = <20>;
		synaptics,reset-delay-ms = <200>;
		synaptics,ub-i2c-addr = <0x70>;
		synaptics,disable-gpios;
		synaptics,x-flip;
	};
};

&i2c_6 {
	lm36923h: lm36923h@36 {
		compatible = "ti,lm36923h";
		reg = <0x36>;
		hwen-gpio = <&tlmm 128 0>;
		dual-3d-bkl;
	};

	nq@28 {
		qcom,nq-esepwr = <&tlmm 75 0>;
	};
};

&dai_mi2s0 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pri_mi2s_sck_active &pri_mi2s_ws_active
		&pri_mi2s_sd0_active &pri_mi2s_sd1_active>;
	pinctrl-1 = <&pri_mi2s_sck_active &pri_mi2s_ws_active
		&pri_mi2s_sd0_active &pri_mi2s_sd1_active>;
	qcom,msm-mi2s-rx-lines = <1>;
	qcom,msm-mi2s-tx-lines = <2>;
};

&snd_9335 {
	/delete-property/ qcom,wsa-max-devs;
	/delete-property/ qcom,wsa-devs;
	/delete-property/ qcom,wsa-aux-dev-prefix;
	qcom,tfa98xx-mi2s;
};

&{/soc/slim@171c0000/tasha_codec} {
	/delete-node/ msm_cdc_pinctrll;
	/delete-node/ msm_cdc_pinctrlr;
	/delete-node/ swr_master;
};
