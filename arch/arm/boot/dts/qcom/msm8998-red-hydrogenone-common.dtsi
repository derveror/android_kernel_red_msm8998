&tlmm {
	red_cam_sensor_rear_wide_active: cam_sensor_rear_wide_active {
		mux {
			pins = "gpio30", "gpio34", "gpio29", "gpio33", "gpio24";
			function = "gpio";
		};

		config {
			pins = "gpio30", "gpio34", "gpio29", "gpio33", "gpio24";
			bias-disable;
			drive-strength = <2>;
		};
	};

	red_cam_sensor_rear_wide_suspend: cam_sensor_rear_wide_suspend {
		mux {
			pins = "gpio30", "gpio34", "gpio29", "gpio33", "gpio24";
			function = "gpio";
		};

		config {
			pins = "gpio30", "gpio34", "gpio29", "gpio33", "gpio24";
			bias-disable;
			drive-strength = <2>;
		};
	};

	red_cam_sensor_rear_tele_active: cam_sensor_rear_tele_active {
		mux {
			pins = "gpio28", "gpio11", "gpio27", "gpio80", "gpio24";
			function = "gpio";
		};

		config {
			pins = "gpio28", "gpio11", "gpio27", "gpio80", "gpio24";
			bias-disable;
			drive-strength = <2>;
		};
	};

	red_cam_sensor_rear_tele_suspend: cam_sensor_rear_tele_suspend {
		mux {
			pins = "gpio28", "gpio11", "gpio27", "gpio80", "gpio24";
			function = "gpio";
		};

		config {
			pins = "gpio28", "gpio11", "gpio27", "gpio80", "gpio24";
			bias-disable;
			drive-strength = <2>;
		};
	};

	red_cam_sensor_front_tele_active: cam_sensor_front_tele_active {
		mux {
			pins = "gpio9", "gpio8", "gpio80", "gpio11";
			function = "gpio";
		};

		config {
			pins = "gpio9", "gpio8", "gpio80", "gpio11";
			bias-disable;
			drive-strength = <2>;
		};
	};

	red_cam_sensor_front_tele_suspend: cam_sensor_front_tele_suspend {
		mux {
			pins = "gpio9", "gpio8", "gpio80", "gpio11";
			function = "gpio";
		};

		config {
			pins = "gpio9", "gpio8", "gpio80", "gpio11";
			bias-pull-down;
			drive-strength = <2>;
			input-enable;
		};
	};

	red_cam_sensor_front_wide_active: cam_sensor_front_wide_active {
		mux {
			pins = "gpio30", "gpio29", "gpio33", "gpio34";
			function = "gpio";
		};

		config {
			pins = "gpio30", "gpio29", "gpio33", "gpio34";
			bias-disable;
			drive-strength = <2>;
		};
	};

	red_cam_sensor_front_wide_suspend: cam_sensor_front_wide_suspend {
		mux {
			pins = "gpio30", "gpio29", "gpio33", "gpio34";
			function = "gpio";
		};

		config {
			pins = "gpio30", "gpio29", "gpio33", "gpio34";
			bias-disable;
			drive-strength = <2>;
		};
	};

	fpc_reset_low: msm_gpio_32 {
		mux {
			pins = "gpio32";
			function = "gpio";
		};

		config {
			pins = "gpio32";
			drive-strength = <2>;
			bias-disable;
			output-low;
		};
	};

	fpc_reset_high: msm_gpio_32_output_high {
		mux {
			pins = "gpio32";
			function = "gpio";
		};

		config {
			pins = "gpio32";
			drive-strength = <2>;
			bias-disable;
			output-high;
		};
	};

	fpc_irq_active: msm_gpio_121 {
		mux {
			pins = "gpio121";
			function = "gpio";
		};

		config {
			pins = "gpio121";
			drive-strength = <2>;
			bias-pull-down;
		};
	};
};

&cci {
	/delete-node/ qcom,camera@0;
	/delete-node/ qcom,camera@1;
	/delete-node/ qcom,camera@2;
	/delete-node/ qcom,camera@3;
	/delete-node/ qcom,eeprom@0;
	/delete-node/ qcom,eeprom@1;
	/delete-node/ qcom,eeprom@2;

	red_camera0: qcom,camera@0 {
		cell-index = <0>;
		compatible = "qcom,camera";
		reg = <0>;
		qcom,csiphy-sd-index = <0>;
		qcom,csid-sd-index = <0>;
		qcom,mount-angle = <90>;
		qcom,led-flash-src = <&led_flash0>;
		qcom,actuator-src = <&actuator0>;
		qcom,eeprom-src = <&red_eeprom0>;
		cam_vdig-supply = <&pm8998_s3>;
		cam_vio-supply = <&pm8998_lvs1>;
		cam_vana-supply = <&pmi8998_bob>;
		cam_v_custom1-supply = <&pm8998_s4>;
		qcom,cam-vreg-name = "cam_vdig", "cam_vio", "cam_vana",
			"cam_v_custom1";
		qcom,cam-vreg-min-voltage = <1352000 0 3312000 1800000>;
		qcom,cam-vreg-max-voltage = <1352000 0 3600000 1800000>;
		qcom,cam-vreg-op-mode = <105000 0 80000 80000>;
		qcom,gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk0_active
			&red_cam_sensor_rear_wide_active>;
		pinctrl-1 = <&cam_sensor_mclk0_suspend
			&red_cam_sensor_rear_wide_suspend>;
		gpios = <&tlmm 13 0>, <&tlmm 30 0>, <&tlmm 34 0>,
			<&tlmm 29 0>, <&tlmm 33 0>, <&tlmm 24 0>;
		qcom,gpio-reset = <1>;
		qcom,gpio-vana = <2>;
		qcom,gpio-vdig = <3>;
		qcom,gpio-custom1 = <4>;
		qcom,gpio-custom2 = <5>;
		qcom,gpio-req-tbl-num = <0 1 2 3 4 5>;
		qcom,gpio-req-tbl-flags = <1 0 0 0 0 0>;
		qcom,gpio-req-tbl-label = "CAMIF_MCLK0", "CAM_RESET0",
			"CAM_VANA", "CAM_VDIG", "CAM_CUSTOM1", "CAM_CUSTOM2";
		qcom,sensor-position = <0>;
		qcom,sensor-mode = <0>;
		qcom,cci-master = <0>;
		status = "ok";
		clocks = <&clock_mmss clk_mclk0_clk_src>,
			<&clock_mmss clk_mmss_camss_mclk0_clk>;
		clock-names = "cam_src_clk", "cam_clk";
		qcom,clock-rates = <24000000 0>;
	};

	red_camera1: qcom,camera@1 {
		cell-index = <1>;
		compatible = "qcom,camera";
		reg = <1>;
		qcom,csiphy-sd-index = <1>;
		qcom,csid-sd-index = <1>;
		qcom,mount-angle = <90>;
		qcom,led-flash-src = <&led_flash0>;
		qcom,actuator-src = <&actuator1>;
		qcom,eeprom-src = <&red_eeprom1>;
		cam_vdig-supply = <&pm8998_s3>;
		cam_vio-supply = <&pm8998_lvs1>;
		cam_vana-supply = <&pmi8998_bob>;
		cam_vaf-supply = <&pm8998_l22>;
		cam_v_custom1-supply = <&pm8998_s4>;
		qcom,cam-vreg-name = "cam_vdig", "cam_vio", "cam_vana",
			"cam_vaf", "cam_v_custom1";
		qcom,cam-vreg-min-voltage = <1352000 0 3312000 2864000 1800000>;
		qcom,cam-vreg-max-voltage = <1352000 0 3600000 2864000 1800000>;
		qcom,cam-vreg-op-mode = <105000 0 80000 80000 80000>;
		qcom,gpio-no-mux = <0>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_mclk1_active
			&red_cam_sensor_rear_tele_active>;
		pinctrl-1 = <&cam_sensor_mclk1_suspend
			&red_cam_sensor_rear_tele_suspend>;
		gpios = <&tlmm 14 0>, <&tlmm 28 0>, <&tlmm 11 0>,
			<&tlmm 27 0>, <&tlmm 80 0>, <&tlmm 24 0>;
		qcom,gpio-reset = <1>;
