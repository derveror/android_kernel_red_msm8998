/* RED Hydrogen One properties shared by production hardware. */

&{/chosen} {
	bootargs = "rcupdate.rcu_expedited=1";
};

&{/reserved-memory} {
	fih_region: fih_region@a0000000 {
		compatible = "removed-dma-pool";
		reg = <0 0xa0000000 0 0xb00000>;
		no-map;
	};

	ramoops_region: ramoops_region@a0b00000 {
		compatible = "removed-dma-pool";
		reg = <0 0xa0b00000 0 0x200000>;
		no-map;
	};
};

&soc {
	ramoops@a0b00000 {
		compatible = "ramoops";
		memory-region = <&ramoops_region>;
		record-size = <0 0x1000>;
		console-size = <0 0x40000>;
		ftrace-size = <0 0x40000>;
		pmsg-size = <0 0x40000>;
	};
};

&pm8998_gpios {
	gpio@c900 {
		qcom,master-en = <0>;
		status = "ok";
	};
};

&pm8998_vadc {
	chan@4e {
		label = "lcd_therm";
		reg = <0x4e>;
		qcom,decimation = <2>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <2>;
		qcom,hw-settle-time = <2>;
		qcom,fast-avg-setup = <0>;
	};

	chan@54 {
		label = "flash_therm";
		reg = <0x54>;
		qcom,decimation = <2>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <2>;
		qcom,hw-settle-time = <2>;
		qcom,fast-avg-setup = <0>;
	};
};

&pm8998_adc_tm {
	chan@4e {
		label = "lcd_therm";
		reg = <0x4e>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <2>;
		qcom,hw-settle-time = <2>;
		qcom,btm-channel-number = <0x70>;
		qcom,thermal-node;
	};

	chan@54 {
		label = "flash_therm";
		reg = <0x54>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <2>;
		qcom,hw-settle-time = <2>;
		qcom,btm-channel-number = <0x98>;
		qcom,thermal-node;
	};
};

&{/soc/qcom,sensor-information} {
	sensor_information30: qcom,sensor-information-30 {
		qcom,sensor-type = "adc";
		qcom,sensor-name = "flash_therm";
	};

	sensor_information31: qcom,sensor-information-31 {
		qcom,sensor-type = "adc";
		qcom,sensor-name = "lcd_therm";
	};
};

&mtp_batterydata {
	/delete-node/ qcom,demo_6000mah;

	qcom,3343615_cloudminds_a2hlish_4510mah_averaged_masterslave_mar7th2018 {
